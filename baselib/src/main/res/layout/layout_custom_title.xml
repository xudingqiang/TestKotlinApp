<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="#c7F7F7F7"
    android:orientation="horizontal">


    <ImageView
        android:id="@+id/imgLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="8dp"
        android:background="@drawable/img_bg"
        android:src="@drawable/icon_left" />


    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@id/imgLeft" />


    <Toolbar android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:tag="drag"
        android:id="@+id/toolBar"
        android:layout_toRightOf="@id/txtTitle"
        android:layout_toLeftOf="@id/imgImport"/>


    <ImageView
        android:id="@+id/imgImport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_gravity="center_vertical|end"
        android:layout_marginRight="8dp"
        android:padding="4dp"
        android:background="@drawable/img_bg"
        android:layout_toLeftOf="@id/imgFullscreen"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/icon_options" />

    <ImageView
        android:id="@+id/imgFullscreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:padding="4dp"
        android:layout_gravity="center_vertical|end"
        android:layout_toLeftOf="@id/imgMinimize"
        android:background="@drawable/img_bg"
        android:src="@drawable/icon_fullscreen" />

    <ImageView
        android:id="@+id/imgMinimize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_gravity="center_vertical|end"
        android:layout_toLeftOf="@id/imgMaximize"
        android:background="@drawable/img_bg"
        android:src="@drawable/icon_minimize" />

    <ImageView
        android:id="@+id/imgMaximize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:padding="4dp"
        android:layout_gravity="center_vertical|end"
        android:layout_toLeftOf="@id/imgClose"
        android:background="@drawable/img_bg"
        android:src="@drawable/icon_maximize" />

    <ImageView
        android:id="@+id/imgClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="16dp"
        android:background="@drawable/img_bg"
        android:src="@drawable/icon_close" />


</RelativeLayout>
